# Public client configuration only. Never put a Supabase secret/service key or
# an AI provider secret in an EXPO_PUBLIC_ variable.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# EAS project UUID used when Expo creates a push token for this installation.
EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Nutrition model/catalogue secrets belong in Supabase Edge Function secrets,
# not in this mobile environment file. See doc/nutrition.md.
