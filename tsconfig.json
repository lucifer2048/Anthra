    "jsx": "react-native",
    "jsxImportSource": "nativewind",
    "strict": true,
    "types": [
      "nativewind/types"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "supabase/functions"
  ]
}
